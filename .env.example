# Groq is the ONLY supported LLM provider for this project.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith tracing/observability. Modern LANGSMITH_* names are preferred;
# legacy LANGCHAIN_* names are also read for backward compatibility. Tracing
# is gracefully disabled if no key is present, regardless of this flag.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=property-investment-advisor

# Risk-based routing threshold (0-100) — also used by the Guardrail Agent
RISK_HUMAN_REVIEW_THRESHOLD=75

# Guardrail confidence threshold (0-1) — recommendations below this require human review
GUARDRAIL_CONFIDENCE_THRESHOLD=0.70

# Retry caps for routing loops
MAX_DATA_RETRIES=2
MAX_REANALYSIS_RETRIES=2

# Set to "true" to auto-approve human review (used by evals / demo / non-interactive runs)
AUTO_APPROVE_HUMAN_REVIEW=false

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# RAG retrieval (character-based chunking; the index rebuilds if chunking changes)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4

# Leverage rule: shortfall after EMI as % of EMI (warning above WARN; cap + BUY needs strong appreciation above CAP)
LEVERED_SHORTFALL_WARN_PCT_OF_EMI=25
LEVERED_SHORTFALL_CAP_PCT_OF_EMI=70
LEVERED_SHORTFALL_CONFIDENCE_CAP=0.75

# Return on equity: stamp duty + registration as % of price
STAMP_DUTY_REGISTRATION_PCT=6

# Appreciation from RBI House Price Index (base 2022-23)
HPI_WINDOW_QUARTERS=12
HPI_CITY_LEVEL_CONFIDENCE=0.85

# HPI rate flagged volatile if 12-quarter and longest-window rates differ by more than this (points)
HPI_VOLATILITY_THRESHOLD_PTS=4

# Hurdle rate for IRR on equity (BUY not allowed below it). Leave unset to use the loan interest rate.
# HURDLE_RATE_PCT=9
